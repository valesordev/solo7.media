---
// A specimen page: the site's base layout and the brand's one content column (visual-language.md#layout).
import Base from '../../src/layouts/Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} specimen · Valesor Development`}>
  <main>
    <h1 class="visually-hidden">{title} specimen</h1>
    <slot />
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-inline-size: var(--layout-max-width);
    margin-inline: auto;
    padding: var(--space-xl) var(--layout-inset);
  }

  .visually-hidden {
    /* Out of view and out of the scroll width (WCAG 1.4.10 at 320px), still read by assistive technology. */
    position: absolute;
    inset-inline-start: 0;
    max-inline-size: 100%;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
