// Assets-only Worker (ADR-0001 §4): no script, dist/ is served as static assets.
// Credentials come from the environment (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID), never this file.
{
  "name": "valesordev-com",
  "compatibility_date": "2026-10-01",
  // Nothing is public until the production story: no workers.dev route, previews only.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
