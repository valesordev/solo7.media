{
  "$comment": "Valesor Development tokens (S7M-VAL-006). Roles and rules: brand/visual-language.md. Built to dist/tokens.css by tokens/build.mjs. Light theme only. A leaf is { value, note? }; \"{a.b}\" refers to another leaf.",
  "color": {
    "paper": { "value": "#FEFEFE", "note": "page ground; neutral near-white (audit: target median)" },
    "ink": { "value": "#111111", "note": "display and body type; #000000 only inside the engraving" },
    "ink-muted": { "value": "#545454", "note": "the single secondary grey; also metadata labels (no ink-faint)" },
    "rule": { "value": "#D0D0D0", "note": "every 1px hairline; one weight (no rule-strong); carries no information on its own" },
    "accent": { "value": "#C8202A", "note": "vermilion; primary action and direction only" }
  },
  "font": {
    "serif": {
      "family": "Source Serif 4",
      "fallback": "Georgia, \"Times New Roman\", serif",
      "files": [
        { "weight": 400, "style": "normal", "src": "assets/fonts/source-serif-4/source-serif-4-latin-400-normal.woff2" }
      ],
      "license": "OFL-1.1",
      "licenseFile": "assets/fonts/source-serif-4/OFL.txt"
    },
    "mono": {
      "family": "Source Code Pro",
      "fallback": "ui-monospace, Menlo, Consolas, monospace",
      "files": [
        { "weight": 400, "style": "normal", "src": "assets/fonts/source-code-pro/source-code-pro-latin-400-normal.woff2" }
      ],
      "license": "OFL-1.1",
      "licenseFile": "assets/fonts/source-code-pro/OFL.txt"
    }
  },
  "type": {
    "base": { "value": "0.9375rem", "note": "body 1x; the target sets body at about 15px" },
    "wordmark": {
      "family": { "value": "serif" }, "scale": { "value": 1.6 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "-0.01em" }
    },
    "display": {
      "family": { "value": "serif" }, "scale": { "value": 4 }, "line-height": { "value": 1.2 },
      "tracking": { "value": "-0.01em" }
    },
    "subhead": {
      "family": { "value": "serif" }, "scale": { "value": 1.7 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "section": {
      "family": { "value": "serif" }, "scale": { "value": 2.4 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "row-title": {
      "family": { "value": "serif" }, "scale": { "value": 1.7 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "column-title": {
      "family": { "value": "serif" }, "scale": { "value": 1.2 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "body": {
      "family": { "value": "mono" }, "scale": { "value": 1 }, "line-height": { "value": 1.6 },
      "tracking": { "value": "0em" }
    },
    "label": {
      "family": { "value": "mono" }, "scale": { "value": 0.85 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0.08em" }, "transform": { "value": "uppercase" }
    },
    "value": {
      "family": { "value": "mono" }, "scale": { "value": 0.85 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "nav": {
      "family": { "value": "serif" }, "scale": { "value": 1 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    },
    "link": {
      "family": { "value": "mono" }, "scale": { "value": 1 }, "line-height": { "value": 1.5 },
      "tracking": { "value": "0em" }
    }
  },
  "space": {
    "3xs": { "value": "0.25rem" },
    "2xs": { "value": "0.5rem" },
    "xs": { "value": "0.75rem" },
    "s": { "value": "1rem" },
    "m": { "value": "1.5rem" },
    "l": { "value": "2rem" },
    "xl": { "value": "3rem" },
    "2xl": { "value": "4.5rem" },
    "3xl": { "value": "6rem" }
  },
  "layout": {
    "max-width": { "value": "75rem", "note": "content column ceiling (visual-language.md#layout)" },
    "measure": { "value": "72ch", "note": "running text in a text page" },
    "inset-narrow": { "value": "{space.m}", "note": "column inset below the breakpoint" },
    "inset-wide": { "value": "3.75rem", "note": "column inset at the breakpoint and up; the target's 60px" },
    "breakpoint-wide": { "value": "48rem", "note": "two layouts: wide at or above, narrow below; media queries cannot read custom properties, so the build writes this value into the inset rule and components repeat it" }
  },
  "line": {
    "rule-width": { "value": "1px" },
    "underline-width": { "value": "1px" },
    "underline-width-hover": { "value": "2px", "note": "hover and active on a link" },
    "focus-width": { "value": "2px" },
    "focus-offset": { "value": "2px" },
    "target-min": { "value": "1.5rem", "note": "24 CSS px minimum target size" }
  },
  "alias": {
    "link-underline-secondary": { "value": "{color.ink-muted}", "note": "secondary TextLink underline; at least 3:1 on paper, and the sampled #AEAEAF is lighter than that" },
    "focus-ring": { "value": "{color.ink}", "note": "2px ink outline, never vermilion" }
  },
  "contrast": [
    { "fg": "color.ink", "bg": "color.paper", "min": 4.5, "use": "display and body type" },
    { "fg": "color.ink-muted", "bg": "color.paper", "min": 4.5, "use": "descriptions, metadata labels and values at the smallest size (0.85x)" },
    { "fg": "color.accent", "bg": "color.paper", "min": 4.5, "use": "primary TextLink text and arrow" },
    { "fg": "alias.link-underline-secondary", "bg": "color.paper", "min": 3, "use": "secondary link underline (non-text)" },
    { "fg": "alias.focus-ring", "bg": "color.paper", "min": 3, "use": "focus outline (non-text)" }
  ]
}
