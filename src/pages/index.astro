---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '@valesordev/ui/SiteHeader.astro';
import SiteFooter from '@valesordev/ui/SiteFooter.astro';
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();

const allArtwork = await getCollection('artwork');
const featured = allArtwork
  .filter((a) => a.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [
  { key: 'photos',     label: 'Photography' },
  { key: 'drawings',   label: 'Drawing' },
  { key: 'generative', label: 'Generative Art' },
];
---

<Layout title="Solo7 Media" description="Photography, drawing, and generative art by Brian.">
  <SiteHeader id="site-header">
    <div slot="logo">
      <a href="/" class="logo-link text-xl font-semibold tracking-tight">
        Solo7 Media
      </a>
    </div>
    <ul slot="nav" class="flex space-x-8 text-sm">
      <li><a href="/work" class="nav-link">Work</a></li>
      <li><a href="/work#photos" class="nav-link">Photos</a></li>
      <li><a href="/work#drawings" class="nav-link">Drawings</a></li>
      <li><a href="/work#generative" class="nav-link">Generative</a></li>
    </ul>
  </SiteHeader>

  <!-- Hero -->
  <section class="hero flex items-center justify-center px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight tracking-tight">
        Art &amp; Images
      </h1>
      <p class="text-lg md:text-xl leading-relaxed mb-10 text-muted">
        Photography, drawing, and generative art. Work made between everything else.
      </p>
      <a href="/work" class="btn-primary">View All Work</a>
    </div>
  </section>

  <!-- Featured -->
  <main class="pb-24 px-4 max-w-6xl mx-auto">
    <h2 class="section-label">Selected Work</h2>

    {featured.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((piece) => (
          <a href={`/work/${piece.slug}`} class="artwork-card group block">
            <div class="artwork-thumb">
              <img
                src={piece.data.image}
                alt={piece.data.title}
                class="artwork-img"
                loading="lazy"
              />
            </div>
            <div class="mt-3">
              <p class="text-white font-medium text-sm">{piece.data.title}</p>
              <p class="text-xs mt-0.5 text-muted">{piece.data.category}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-muted">Work coming soon.</p>
    )}

    <!-- Category links -->
    <div class="category-grid">
      {categories.map(({ key, label }) => {
        const count = allArtwork.filter((a) => a.data.category === key).length;
        return (
          <a href={`/work#${key}`} class="category-link group">
            <p class="text-white font-medium text-lg">{label}</p>
            <p class="text-sm mt-1 text-muted">{count} {count === 1 ? 'piece' : 'pieces'}</p>
          </a>
        );
      })}
    </div>
  </main>

  <SiteFooter>
    <div class="text-center text-sm text-muted">
      <p>&copy; {year} Brian &middot; solo7.media</p>
    </div>
  </SiteFooter>
</Layout>

<style>
  .logo-link { color: var(--color-accent); text-decoration: none; }
  .nav-link { color: var(--color-muted); text-decoration: none; transition: color 0.15s; }
  .nav-link:hover { color: #fff; }

  .hero { min-height: 100vh; }
  .text-muted { color: var(--color-muted); }

  .btn-primary {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--color-accent);
    color: #0c0c0c;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-hover); }

  .section-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  .artwork-card { text-decoration: none; }
  .artwork-thumb {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-surface);
  }
  .artwork-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .artwork-card:hover .artwork-img { transform: scale(1.04); }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--color-border);
  }
  .category-link { text-decoration: none; }
  .category-link:hover p:first-child { color: var(--color-accent); transition: color 0.15s; }
</style>
